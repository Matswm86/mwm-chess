[Unit]
Description=MWM Chess online rooms (chess.mwmai.no)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/mwm-chess
Environment=CHESS_PORT=8796
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/services/mwm-chess/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
